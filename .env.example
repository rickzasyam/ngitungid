# ─────────────────────────────────────────────────────────────────────────────
# Neon Postgres — DATABASE_URL is a SINGLE switch. EVERYTHING reads it:
# the app (lib/db/index.ts), every `pnpm db:*` drizzle-kit command
# (generate/migrate/push/studio), `db:seed`, `db:seed:dev`, and any throwaway
# `tsx --env-file=.env.local` script. There is no per-command safety.
#
# There are TWO Neon branches (see README.md § "Database environments"):
#   • main → PRODUCTION. Real client data. NEVER point .env.local here for
#            testing, seeding, db:push, or throwaway scripts. Production deploy
#            (Vercel) uses its OWN DATABASE_URL env var, not this file.
#   • dev  → daily work, testing, db:seed:dev, throwaway clients. Your local
#            .env.local should point at the DEV branch during development.
#
# Setup: copy this file to .env.local and paste the DEV branch connection string
# (.env.local is gitignored — never commit real credentials).
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v5 — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
# Set to true if deploying somewhere other than Vercel (own server/Docker/etc)
AUTH_TRUST_HOST=true

# First admin account credentials — used by `pnpm db:seed`
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="choose-a-real-password"
SEED_ADMIN_NAME="Your Name"

# Gemini API key — ekstraksi PDF laporan keuangan (Phase 3.1).
# Buat gratis di https://aistudio.google.com/apikey
# CATATAN kuota: free tier gemini-3.5-flash = 5 request/menit. Satu upload
# memakai 1 request per file (P&L/Neraca/Arus Kas). Untuk pemakaian rutin
# (banyak klien/laporan), pertimbangkan billing berbayar.
GEMINI_API_KEY="your-gemini-api-key"
# Opsional — override model (default: gemini-3.5-flash)
# GEMINI_MODEL="gemini-3.5-flash"
# Sakelar "Sarankan akun (AI)": selain "true" = mati (lib/ai-features.ts).
# Production sengaja TIDAK diisi sampai Gemini paid tier aktif.
AI_FEATURES_ENABLED="true"
# Fitur AI BARU punya sakelar SENDIRI, bawaan MATI walau AI_FEATURES_ENABLED="true".
# Ekstraksi PDF rekening koran (MP §5.G Modul B) — di Production hanya diisi di
# X7, sesudah gerbang X0 dan D54. Sebelum itu hanya PDF SINTETIS, juga di dev.
# AI_EKSTRAKSI_REKENING_KORAN="true"
# Penyedia untuk fitur BARU saja (fitur lama tetap Gemini): gemini | anthropic | openai.
# Nama env PER FITUR. Kosong = gemini. AI_MODEL_EKSTRAKSI kosong = bawaan penyedia:
# gemini → gemini-3.5-flash-lite (thinking minimal), anthropic → claude-haiku-5-5,
# openai WAJIB diisi. `AI_PROVIDER` / `AI_MODEL` umum tidak dibaca fitur mana pun.
# AI_PROVIDER_EKSTRAKSI="gemini"
# AI_MODEL_EKSTRAKSI=""
# Ulang otomatis (keputusan Ricko 2026-10-30): halaman yang DITOLAK PENJAGA diulang
# SEKALI dengan model ini; ditolak lagi → halaman diisi manual. Penyedianya sama
# dengan AI_PROVIDER_EKSTRAKSI. Tidak diisi → gemini: gemini-3.5-flash; penyedia lain:
# mati. Diisi KOSONG (AI_MODEL_EKSTRAKSI_ULANG="") → MATI. Sama dengan model utama →
# mati. Tetap di balik AI_EKSTRAKSI_REKENING_KORAN. Model per halaman ada di header
# respons X-Model-Ekstraksi (+ X-Ekstraksi-Diulang "1"/"0").
# AI_MODEL_EKSTRAKSI_ULANG="gemini-3.5-flash"
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — error tracking (server + client). Ambil DSN-nya di Sentry Console:
# Settings → Projects → <project> → Client Keys (DSN).
#
# ISI NILAI ASLINYA DI .env.local, JANGAN DI FILE INI — file ini di-commit.
# Prefix NEXT_PUBLIC_ memang diperlukan supaya SDK browser bisa membacanya; DSN
# dirancang publik (ikut ter-bundle ke JS client) dan hanya bisa MENGIRIM event,
# tidak bisa membaca data project. Kalau kosong, Sentry otomatis non-aktif —
# jadi kontributor tanpa DSN tetap bisa menjalankan app.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://<public-key>@<org>.ingest.<region>.sentry.io/<project-id>"
