# ─────────────────────────────────────────────────────────────────────────────
# Neon Postgres — DATABASE_URL is a SINGLE switch. EVERYTHING reads it:
# the app (lib/db/index.ts), every `pnpm db:*` drizzle-kit command
# (generate/migrate/push/studio), `db:seed`, `db:seed:dev`, and any throwaway
# `tsx --env-file=.env.local` script. There is no per-command safety.
#
# There are TWO Neon branches (see README.md § "Database environments"):
#   • main → PRODUCTION. Real client data. NEVER point .env.local here for
#            testing, seeding, db:push, or throwaway scripts. Production deploy
#            (Vercel) uses its OWN DATABASE_URL env var, not this file.
#   • dev  → daily work, testing, db:seed:dev, throwaway clients. Your local
#            .env.local should point at the DEV branch during development.
#
# Setup: copy this file to .env.local and paste the DEV branch connection string
# (.env.local is gitignored — never commit real credentials).
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v5 — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
# Set to true if deploying somewhere other than Vercel (own server/Docker/etc)
AUTH_TRUST_HOST=true

# First admin account credentials — used by `pnpm db:seed`
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="choose-a-real-password"
SEED_ADMIN_NAME="Your Name"

# Gemini API key — ekstraksi PDF laporan keuangan (Phase 3.1).
# Buat gratis di https://aistudio.google.com/apikey
# CATATAN kuota: free tier gemini-3.5-flash = 5 request/menit. Satu upload
# memakai 1 request per file (P&L/Neraca/Arus Kas). Untuk pemakaian rutin
# (banyak klien/laporan), pertimbangkan billing berbayar.
GEMINI_API_KEY="your-gemini-api-key"
# Opsional — override model (default: gemini-3.5-flash)
# GEMINI_MODEL="gemini-3.5-flash"
